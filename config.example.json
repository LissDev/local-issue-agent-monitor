{
  "repositories": [
    "example-org/example-repo"
  ],
  "githubCredentialProvider": {
    "type": "system-store"
  },
  "pollIntervalSeconds": 60,
  "watchedLabels": [
    "status:ready",
    "agent:run"
  ],
  "launch": {
    "enabled": false,
    "worktreeDirectory": "C:\\IssueAgentWorktrees",
    "statePath": "C:\\Users\\YOUR_NAME\\AppData\\Local\\local-issue-agent-monitor\\launches.json",
    "repositoryPaths": {
      "example-org/example-repo": "C:\\src\\example-repo"
    },
    "codexCommand": "codex",
    "runner": {
      "type": "codex",
      "approvalMode": "default"
    }
  }
}
